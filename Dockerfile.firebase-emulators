FROM node:22-trixie-slim

RUN apt-get update \
  && apt-get install --no-install-recommends --yes openjdk-21-jre-headless \
  && rm -rf /var/lib/apt/lists/*

RUN npm install --global firebase-tools@15.24.0

WORKDIR /workspace

COPY scripts/docker-firebase-emulators.sh /usr/local/bin/firebase-emulators

RUN chmod +x /usr/local/bin/firebase-emulators

EXPOSE 4000 8085 9099 9150

ENTRYPOINT ["firebase-emulators"]
